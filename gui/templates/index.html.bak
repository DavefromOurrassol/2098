<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ourrassol 2098</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <!-- Leaflet.Draw (26 août 2026) : plugin de dessin de polygones custom pour
       les overlays géographie (zones qui coupent un pays en deux) -- voir
       check_overlay_portion_coherence.py et les routes /api/carte/overlays/*.
       CSS après leaflet.css : Leaflet.Draw surcharge quelques classes Leaflet
       de base, l'ordre de chargement des CSS doit respecter ça. -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css">
  <style>
    /* ── Redimensionnement du sidebar à la souris (31 juillet 2026) ── */
    #sidebar {
      min-width: 180px; max-width: 600px; overflow-x: hidden;
      box-sizing: border-box;
    }
    #sidebar-resizer {
      width: 6px; flex-shrink: 0; cursor: col-resize;
      background: transparent; position: relative;
    }
    #sidebar-resizer:hover, #sidebar-resizer.dragging {
      background: #d8c8f0;
    }
    #sidebar-resizer::after {
      content: ''; position: absolute; top: 0; bottom: 0; left: 2px;
      width: 2px; background: #e0e0e0;
    }
    #sidebar-resizer:hover::after, #sidebar-resizer.dragging::after {
      background: #6a3db5;
    }
    body.sidebar-resizing { cursor: col-resize; user-select: none; }

    /* ── Options avancées (mécanisme générique ajouté le 31 juillet 2026) ── */
    .advanced-options {
      margin-top: 10px; border: 1px solid #ddd; border-radius: 6px;
      padding: 6px 10px; background: #fafafa;
    }
    .advanced-options summary {
      cursor: pointer; font-size: 12px; color: #555; font-weight: 600;
      padding: 4px 0; user-select: none;
    }
    .advanced-options[open] summary { margin-bottom: 6px; }

    /* ── Onglet Carte ── */
    #tab-carte { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; }
    #tab-carte.active { display: flex; }
    .carte-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
    .carte-toolbar select { font-family: 'JetBrains Mono', monospace; padding: 4px 8px; border: 1px solid #ccc; border-radius: 4px; background: #fff; }
    .carte-status { font-size: 12px; color: #888; }
    .carte-diagnostic { background: #fff4e0; border: 1px solid #e0b060; border-radius: 4px; padding: 8px 12px; font-size: 11px; margin-bottom: 10px; color: #7a5010; }
    .carte-layout { display: flex; gap: 16px; flex: 1; min-height: 0; }
    #carte-map { flex: 1; min-width: 0; border-radius: 6px; border: 1px solid #ddd; background: #eeecea; }
    .carte-sidebar { width: 300px; flex-shrink: 0; display: flex; flex-direction: column; gap: 12px; overflow-y: auto; }
    .carte-legend { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 10px; font-size: 11px; }
    .carte-legend-item { display: flex; align-items: center; gap: 6px; padding: 2px 0; }
    .carte-legend-rename-btn {
      margin-left: auto; border: none; background: transparent; cursor: pointer;
      font-size: 10px; opacity: 0.4; padding: 2px 4px; border-radius: 3px;
    }
    .carte-legend-rename-btn:hover { opacity: 1; background: #eee; }

    /* ── Recherche de zone (tous niveaux, 14 juillet 2026) ── */
    .carte-search { position: relative; }
    .carte-search input {
      width: 100%; box-sizing: border-box; padding: 6px 8px; font-size: 12px;
      border: 1px solid #ddd; border-radius: 4px; font-family: 'JetBrains Mono', monospace;
    }
    .carte-search input:focus { outline: none; border-color: #3b6fd4; }
    #carte-search-results {
      display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 20;
      background: #fff; border: 1px solid #ddd; border-top: none; border-radius: 0 0 6px 6px;
      max-height: 260px; overflow-y: auto; box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }
    .carte-search-result { padding: 6px 8px; cursor: pointer; border-bottom: 1px solid #f0f0f0; font-size: 11px; }
    .carte-search-result:last-child { border-bottom: none; }
    .carte-search-result:hover { background: #eef4fa; }
    .carte-search-result-nom { font-weight: 600; color: #222; }
    .carte-search-result-niveau {
      font-size: 9px; color: #3b6fd4; background: #eef4fa; border-radius: 3px;
      padding: 1px 5px; margin-left: 6px; text-transform: uppercase;
    }
    .carte-search-result-chemin { font-size: 10px; color: #999; margin-top: 2px; font-family: 'JetBrains Mono', monospace; }
    .carte-search-empty { padding: 8px; font-size: 11px; color: #999; font-style: italic; }
    .arbre-zone-node-row.surlignee-recherche { background: #fff4e0; border-radius: 4px; transition: background 2s ease; }

    .arbre-zone-branch { position: relative; }
    .arbre-zone-node-row {
      display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;
      padding: 4px 0; position: relative;
    }
    .arbre-zone-children {
      margin-left: 9px; padding-left: 13px;
      border-left: 1.5px solid #dde3ee;
    }
    .arbre-zone-children > .arbre-zone-branch > .arbre-zone-node-row::before {
      content: ""; position: absolute; left: -13px; top: 13px;
      width: 11px; height: 1.5px; background: #dde3ee;
    }
    .arbre-zone-nom { color: #222; }
    .arbre-zone-slug { color: #aaa; font-family: 'JetBrains Mono', monospace; font-size: 10px; }
    .arbre-niveau-1 .arbre-zone-nom, .arbre-zone-node-row.arbre-niveau-1 .arbre-zone-nom {
      font-weight: 700; font-size: 13px;
    }
    .arbre-zone-node-row.arbre-niveau-2 .arbre-zone-nom { font-weight: 600; font-size: 11px; }
    .arbre-zone-node-row.arbre-niveau-3 .arbre-zone-nom { font-weight: 400; font-size: 11px; color: #555; }
    .arbre-zone-move-btn {
      margin-left: auto; border: 1px solid #dde3ee; background: #fff; cursor: pointer;
      font-size: 9px; padding: 2px 6px; border-radius: 3px; color: #3b6fd4;
    }
    .arbre-zone-move-btn:hover { background: #eef4fa; }
    .arbre-zone-split-btn {
      margin-left: auto; border: 1px solid #f0d8c0; background: #fff; cursor: pointer;
      font-size: 9px; padding: 2px 6px; border-radius: 3px; color: #b5651d;
    }
    .arbre-zone-split-btn:hover { background: #fdf2e8; }
    .arbre-zone-type {
      background: #eef4fa; color: #3b6fd4; border-radius: 3px;
      padding: 1px 5px; font-size: 9px; text-transform: uppercase;
    }
    .arbre-zone-statut {
      background: #f5f0e0; color: #8a6d10; border-radius: 3px;
      padding: 1px 5px; font-size: 9px;
    }
    .carte-legend-swatch { width: 12px; height: 12px; border-radius: 2px; flex-shrink: 0; }
    .carte-legend-badge {
      font-size: 9px; padding: 1px 4px; border-radius: 3px; background: #eee;
      color: #666; border: 1px dashed #999; flex-shrink: 0;
    }
    .carte-panel { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 12px; font-size: 12px; }
    .carte-panel-empty { color: #999; font-style: italic; }
    .carte-panel-title { font-weight: 700; font-size: 14px; margin-bottom: 4px; }
    .carte-panel-sub { color: #888; margin-bottom: 10px; }
    .carte-panel-section { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #eee; }
    .carte-panel-section:last-child { border-bottom: none; }
    .carte-panel-section label { display: block; font-size: 11px; color: #666; margin-bottom: 4px; }
    .carte-panel-section select { width: 100%; padding: 4px; margin-bottom: 6px; font-family: 'JetBrains Mono', monospace; font-size: 11px; }
    .carte-panel-proposal-box { background: #f5f7fc; border: 1px solid #d0d8f0; border-radius: 4px; padding: 8px; margin-top: 8px; font-size: 11px; }
    .carte-panel-error { color: #c0392b; font-size: 11px; }
    .carte-panel-pays-btn { display: block; width: 100%; margin-bottom: 4px; text-align: left; }
    #carte-panel-msg { font-size: 11px; color: #3b6fd4; margin-top: 8px; }

    /* ── Toggle "forcer le modèle" ── */
    .llm-force-row {
      display: flex; align-items: flex-start; gap: 6px;
      font-size: 11px; color: #888; margin-top: 8px; line-height: 1.4; cursor: pointer;
    }
    .llm-force-row input[type="checkbox"] { margin-top: 1px; cursor: pointer; }
    .llm-force-row.active { color: #7a5010; }
    #llm-routing-note { font-size: 10px; color: #999; margin-top: 4px; font-style: italic; }

    /* ── Note contextuelle par mode (sous les onglets Mode) ── */
    .mode-note {
      font-size: 11px; color: #5a7a9a; background: #eef4fa;
      border-left: 2px solid #a8c8e8; padding: 6px 10px;
      margin-top: 8px; border-radius: 0 4px 4px 0; line-height: 1.4;
    }

    /* ── Bandeau d'alerte "modèle forcé" — sticky, visible sur toute vue ── */
    #llm-force-banner {
      display: none;
      background: #fff4e0; border-bottom: 2px solid #e0b060;
      color: #7a5010; font-size: 12px; font-weight: 600;
      padding: 8px 20px; display: flex; align-items: center; gap: 10px;
      flex-shrink: 0;
    }
    #llm-force-banner .icon { font-size: 14px; }
    #llm-force-banner button {
      margin-left: auto; font-size: 11px; font-weight: 400;
      background: #fff; border: 1px solid #e0b060; border-radius: 4px;
      padding: 3px 10px; cursor: pointer; color: #7a5010;
    }
    #llm-force-banner button:hover { background: #fff0d0; }

    /* ── Bandeau global "Mois de parution" (7 septembre 2026) ── sticky,
       visible sur TOUTE vue (contrairement aux bandeaux locaux déjà
       existants -- #sujets-banner, écran "Générer un article" -- limités
       à leur propre onglet). Même palette que .injev-banner pour rester
       cohérent visuellement avec les autres mentions du mois de parution. */
    #mois-parution-banner {
      background: #eef4fb; border-bottom: 1px solid #cfe0f0;
      color: #34495e; font-size: 12px; font-weight: 600;
      padding: 6px 20px; flex-shrink: 0;
    }

    /* ── Onglet Chantiers (point 4.5, 26 juillet 2026) ── */
    #tab-chantiers { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; overflow-y: auto; }
    #tab-chantiers.active { display: flex; }
    .chantiers-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
    .chantiers-toolbar select { font-family: 'JetBrains Mono', monospace; padding: 4px 8px; border: 1px solid #ccc; border-radius: 4px; background: #fff; font-size: 12px; }
    .chantiers-toolbar-spacer { flex: 1; }
    .chantiers-count { font-size: 11px; color: #888; }
    .chantiers-empty { color: #999; font-style: italic; font-size: 13px; padding: 20px 0; }
    .chantiers-scenario-group { border: 1px solid #ddd; border-radius: 6px; margin-bottom: 14px; overflow: hidden; }
    .chantiers-scenario-header { display: flex; align-items: center; gap: 8px; padding: 8px 14px; background: #f4f2f0; border-bottom: 1px solid #eee; font-weight: 600; font-size: 13px; text-transform: capitalize; }
    .chantiers-scenario-count { font-size: 11px; color: #999; font-weight: 400; font-family: 'JetBrains Mono', monospace; }
    .chantiers-row { padding: 10px 14px; border-bottom: 1px solid #f0f0f0; font-size: 12px; }
    .chantiers-row:last-child { border-bottom: none; }
    .chantiers-row-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .chantiers-cible { font-weight: 600; color: #222; }
    .chantiers-type-badge { font-size: 9px; text-transform: uppercase; padding: 1px 6px; border-radius: 8px; background: #eef4fa; color: #3b6fd4; }
    .chantiers-statut-badge { font-size: 9px; padding: 1px 6px; border-radius: 8px; font-weight: 600; }
    .chantiers-statut-a_traiter { background: #fff3e0; color: #c05c00; }
    .chantiers-statut-ignore { background: #eee; color: #888; }
    .chantiers-statut-traite { background: #e8f5ed; color: #2e7d4f; }
    .chantiers-approuvee-badge { font-size: 9px; padding: 1px 6px; border-radius: 8px; background: #e8f5ed; color: #2e7d4f; font-weight: 600; }
    .chantiers-probleme { color: #666; margin-top: 4px; line-height: 1.4; }
    .chantiers-actions { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    .chantiers-btn { font-size: 11px; padding: 3px 10px; border-radius: 4px; cursor: pointer; border: 1px solid #ddd; background: #fff; color: #555; transition: all 0.1s; }
    .chantiers-btn:hover { border-color: #3b6fd4; color: #2a52a8; }
    .chantiers-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .chantiers-btn-primary { border-color: #3b6fd4; color: #2a52a8; background: #eef4fa; font-weight: 600; }
    .chantiers-btn-primary:hover { background: #3b6fd4; color: #fff; }
    .chantiers-btn-danger { border-color: #c0392b; color: #c0392b; }
    .chantiers-btn-danger:hover { background: #fdecea; }
    .chantiers-proposal-box { background: #f5f7fc; border: 1px solid #d0d8f0; border-radius: 4px; padding: 8px 10px; margin-top: 8px; font-size: 11px; font-family: 'JetBrains Mono', monospace; white-space: pre-wrap; word-break: break-word; max-height: 180px; overflow-y: auto; color: #444; }
    .chantiers-row-msg { font-size: 11px; margin-top: 6px; }
    .chantiers-row-msg.ok { color: #2e7d4f; }
    .chantiers-row-msg.error { color: #c0392b; }
    .chantiers-row-msg.loading { color: #888; font-style: italic; }

    /* ── Onglet Rédaction — journalistes & orateurs (point 3, 30 août 2026) ── */
    #tab-redaction { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; min-height: 0; }
    #tab-redaction.active { display: flex; }
    .redaction-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; flex-shrink: 0; }
    .redaction-toolbar label { font-size: 11px; color: #888; }
    .redaction-toolbar select, .redaction-toolbar input[type="text"] {
      font-family: 'JetBrains Mono', monospace; padding: 4px 8px; border: 1px solid #ccc;
      border-radius: 4px; background: #fff; font-size: 12px;
    }
    .redaction-filter-group { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .redaction-toolbar input[type="text"] { width: 140px; }
    .redaction-count { font-size: 11px; color: #888; margin-left: auto; }
    .redaction-layout { display: flex; gap: 16px; flex: 1; min-height: 0; }
    .redaction-table-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; min-height: 0; }
    .redaction-table-scroll { flex: 1; min-height: 0; overflow-y: auto; border: 1px solid #eee; border-radius: 6px; }
    /* ── Redimensionnement du panneau de détail Rédaction (7 septembre 2026) ──
       Même mécanisme que #sidebar-resizer (poignée de glissement, largeur
       mémorisée dans localStorage) -- le panneau était figé à 340px,
       tronquant la lecture de champs longs (ton du journal, ton_personnel). */
    #redaction-resizer {
      width: 6px; flex-shrink: 0; cursor: col-resize;
      background: transparent; position: relative;
    }
    #redaction-resizer:hover, #redaction-resizer.dragging {
      background: #d8c8f0;
    }
    #redaction-resizer::after {
      content: ''; position: absolute; top: 0; bottom: 0; left: 2px;
      width: 2px; background: #e0e0e0;
    }
    #redaction-resizer:hover::after, #redaction-resizer.dragging::after {
      background: #6a3db5;
    }
    body.redaction-resizing { cursor: col-resize; user-select: none; }
    .redaction-table { width: 100%; border-collapse: collapse; font-size: 12px; table-layout: fixed; }
    .redaction-table thead { position: sticky; top: 0; background: #fff; z-index: 1; }
    .redaction-table th {
      text-align: left; padding: 6px 6px; font-weight: 600; color: #666;
      border-bottom: 2px solid #ddd; cursor: pointer; user-select: none;
    }
    .redaction-table th:hover { color: #3b6fd4; }
    .redaction-table td { padding: 5px 6px; border-bottom: 1px solid #f0f0f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .redaction-table tbody tr { cursor: pointer; }
    .redaction-table tbody tr:hover { background: #f5f7fc; }
    .redaction-table tbody tr.active { background: #eef4fa; }
    .redaction-ton-vide { color: #bbb; font-style: italic; }
    .redaction-ton-rempli { color: #2e7d4f; }
    .redaction-empty { color: #999; font-style: italic; font-size: 13px; padding: 20px 0; text-align: center; }
    .redaction-pagination {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 4px 0; font-size: 11px; color: #888; flex-shrink: 0;
    }
    .redaction-pagination-btns { display: flex; align-items: center; gap: 10px; }
    .redaction-pagination-btns button {
      font-size: 11px; padding: 3px 10px; border-radius: 4px; cursor: pointer;
      border: 1px solid #ddd; background: #fff; color: #555;
    }
    .redaction-pagination-btns button:disabled { opacity: 0.4; cursor: not-allowed; }
    .redaction-pagination-btns button:not(:disabled):hover { border-color: #3b6fd4; color: #2a52a8; }
    .redaction-sidebar { width: 340px; min-width: 280px; max-width: 900px; flex-shrink: 0; overflow-y: auto; box-sizing: border-box; }
    .redaction-panel { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 14px; font-size: 12px; }
    .redaction-panel-empty { color: #999; font-style: italic; }
    .redaction-panel-title { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
    .redaction-panel-sub { color: #888; margin-bottom: 12px; }
    .redaction-panel-section { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #eee; }
    .redaction-panel-section:last-child { border-bottom: none; }
    .redaction-panel-section label { display: block; font-size: 11px; color: #666; margin-bottom: 4px; }
    .redaction-panel-list { font-size: 11px; color: #555; }
    .redaction-ton-mode-tabs { display: flex; gap: 6px; margin-bottom: 8px; }
    .redaction-ton-mode-tab {
      flex: 1; text-align: center; font-size: 11px; padding: 4px 6px; border-radius: 4px;
      border: 1px solid #ddd; background: #fff; color: #555; cursor: pointer;
    }
    .redaction-ton-mode-tab.active { border-color: #3b6fd4; color: #2a52a8; background: #eef4fa; font-weight: 600; }
    .redaction-panel textarea {
      width: 100%; box-sizing: border-box; font-family: 'JetBrains Mono', monospace;
      font-size: 11px; padding: 6px; border: 1px solid #ccc; border-radius: 4px; resize: vertical;
    }
    .redaction-panel-current { background: #f7f7f5; border-radius: 4px; padding: 6px 8px; font-size: 11px; color: #444; margin-bottom: 8px; line-height: 1.4; }
    .redaction-panel-warning { background: #fff4e0; border: 1px solid #e0b060; border-radius: 4px; padding: 6px 8px; font-size: 11px; color: #7a5010; margin-bottom: 8px; }
    .redaction-panel-btn {
      font-size: 11px; padding: 4px 12px; border-radius: 4px; cursor: pointer;
      border: 1px solid #3b6fd4; color: #2a52a8; background: #eef4fa; font-weight: 600;
    }
    .redaction-panel-btn:hover { background: #3b6fd4; color: #fff; }
    .redaction-panel-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .redaction-panel-msg { font-size: 11px; margin-top: 8px; }
    .redaction-panel-msg.ok { color: #2e7d4f; }
    .redaction-panel-msg.error { color: #c0392b; }
    .redaction-panel-msg.loading { color: #888; font-style: italic; }
    .redaction-chips-box { display: flex; flex-wrap: wrap; gap: 6px; }
    .redaction-chip {
      display: flex; align-items: center; gap: 4px; font-size: 11px;
      padding: 3px 8px; border-radius: 12px; border: 1px solid #ddd;
      background: #fff; color: #666; cursor: pointer; user-select: none;
    }
    .redaction-chip input { margin: 0; cursor: pointer; }
    .redaction-chip.active { border-color: #3b6fd4; background: #eef4fa; color: #2a52a8; font-weight: 600; }
    .redaction-panel-hint { font-size: 10px; color: #999; margin-top: 4px; width: 100%; }
    .redaction-panel-hint.over { color: #b5651d; }
    #redaction-seniorite-select {
      font-family: 'JetBrains Mono', monospace; padding: 4px 8px; border: 1px solid #ccc;
      border-radius: 4px; background: #fff; font-size: 12px;
    }

    /* ── Onglet Articles — inventaire complet (5 septembre 2026, chantier
       "Suite narrative des événements") -- même gabarit que .redaction-*
       (table triable + filtres + pagination + panneau), classes dupliquées
       sous préfixe articles- pour rester lisible malgré le contenu différent
       (articles, pas personnes). ── */
    #tab-articles { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; min-height: 0; }
    #tab-articles.active { display: flex; }
    .articles-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; flex-shrink: 0; }
    .articles-toolbar label { font-size: 11px; color: #888; }
    .articles-toolbar select, .articles-toolbar input[type="text"] {
      font-family: 'JetBrains Mono', monospace; padding: 4px 8px; border: 1px solid #ccc;
      border-radius: 4px; background: #fff; font-size: 12px;
    }
    .articles-filter-group { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .articles-toolbar input[type="text"] { width: 160px; }
    .articles-count { font-size: 11px; color: #888; margin-left: auto; }
    .articles-layout { display: flex; gap: 16px; flex: 1; min-height: 0; }
    .articles-table-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; min-height: 0; }
    .articles-table-scroll { flex: 1; min-height: 0; overflow-y: auto; border: 1px solid #eee; border-radius: 6px; }
    .articles-table { width: 100%; border-collapse: collapse; font-size: 12px; table-layout: fixed; }
    .articles-table thead { position: sticky; top: 0; background: #fff; z-index: 1; }
    .articles-table th {
      text-align: left; padding: 6px 6px; font-weight: 600; color: #666;
      border-bottom: 2px solid #ddd; cursor: pointer; user-select: none;
    }
    .articles-table th:hover { color: #3b6fd4; }
    .articles-table td { padding: 5px 6px; border-bottom: 1px solid #f0f0f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .articles-table tbody tr { cursor: pointer; }
    .articles-table tbody tr:hover { background: #f5f7fc; }
    .articles-table tbody tr.active { background: #eef4fa; }
    .articles-empty { color: #999; font-style: italic; font-size: 13px; padding: 20px 0; text-align: center; }
    .articles-pagination {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 4px 0; font-size: 11px; color: #888; flex-shrink: 0;
    }
    .articles-pagination-btns { display: flex; align-items: center; gap: 10px; }
    .articles-pagination-btns button {
      font-size: 11px; padding: 3px 10px; border-radius: 4px; cursor: pointer;
      border: 1px solid #ddd; background: #fff; color: #555;
    }
    .articles-pagination-btns button:disabled { opacity: 0.4; cursor: not-allowed; }
    .articles-pagination-btns button:not(:disabled):hover { border-color: #3b6fd4; color: #2a52a8; }
    .articles-sidebar { width: 360px; min-width: 280px; max-width: 900px; flex-shrink: 0; overflow-y: auto; box-sizing: border-box; }
    /* ── Redimensionnement des panneaux Articles/Instances/Événements
       (7 septembre 2026) -- classe générique réutilisée sur les 3 onglets
       qui partagent le gabarit .articles-sidebar, même mécanisme que
       #redaction-resizer (poignée de glissement, largeur mémorisée dans
       localStorage, une clé par onglet). ── */
    .panel-resizer {
      width: 6px; flex-shrink: 0; cursor: col-resize;
      background: transparent; position: relative;
    }
    .panel-resizer:hover, .panel-resizer.dragging {
      background: #d8c8f0;
    }
    .panel-resizer::after {
      content: ''; position: absolute; top: 0; bottom: 0; left: 2px;
      width: 2px; background: #e0e0e0;
    }
    .panel-resizer:hover::after, .panel-resizer.dragging::after {
      background: #6a3db5;
    }
    body.panel-resizing { cursor: col-resize; user-select: none; }
    .articles-panel { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 14px; font-size: 12px; }
    .articles-panel-empty { color: #999; font-style: italic; }
    .articles-panel-title { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
    .articles-panel-sub { color: #888; margin-bottom: 12px; }
    .articles-panel-section { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #eee; }
    .articles-panel-section:last-child { border-bottom: none; }
    .articles-panel-section label { display: block; font-size: 11px; color: #666; margin-bottom: 4px; }

    /* ── Onglet Instances (chantier "GUI Entités/Instances/Événements/
       Signaux", 7 septembre 2026) -- réutilise directement les classes
       .articles-* ci-dessus (table triable + filtres + pagination +
       panneau) : structure identique, seul le display du conteneur
       diffère par onglet. Pas de duplication CSS. ── */
    #tab-instances { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; min-height: 0; }
    #tab-instances.active { display: flex; }
    #tab-event_instances { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; min-height: 0; }
    #tab-event_instances.active { display: flex; }
    #tab-signaux { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; min-height: 0; }
    #tab-signaux.active { display: flex; }
    #tab-resumes { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; min-height: 0; overflow-y: auto; }
    #tab-resumes.active { display: flex; }
    /* ── Onglet Résumés par scénario (7 septembre 2026) -- gabarit différent
       des autres onglets de ce chantier : pas de table+panneau (une seule
       valeur par scénario, 6 au total), une grille de cartes à la place. ── */
    .resumes-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; flex-shrink: 0; }
    .resumes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 16px; }
    .resumes-card { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 16px; }
    .resumes-card-title { font-weight: 700; font-size: 15px; margin-bottom: 2px; }
    .resumes-card-meta { font-size: 11px; color: #888; margin-bottom: 10px; }
    .resumes-card-text { font-size: 13px; line-height: 1.5; white-space: pre-wrap; margin-bottom: 10px; }
    .resumes-card-empty { color: #999; font-style: italic; font-size: 13px; margin-bottom: 10px; }
    .resumes-card button { font-size: 11px; padding: 4px 10px; border-radius: 4px; cursor: pointer; border: 1px solid #ddd; background: #fff; color: #555; }
    .resumes-card button:disabled { opacity: 0.5; cursor: not-allowed; }
    .resumes-card button:not(:disabled):hover { border-color: #3b6fd4; color: #2a52a8; }


    /* ── Audit & édition de sujets (5 septembre 2026, chantier "Suite
       narrative des événements", point B) -- même gabarit visuel que
       .injev-* (toolbar filtres + layout liste/panneau), classes
       dupliquées sous préfixe sujets- pour rester lisible. Deux zones
       dans le panneau : l'aperçu (toujours affiché en premier, jamais
       d'écriture) et les boutons de confirmation explicite pour les
       actions destructives (suppression, modification de date) --
       jamais un seul clic n'exécute directement une action. */
    #tab-sujets { display: none; flex-direction: column; height: 100%; padding: 20px; box-sizing: border-box; min-height: 0; }
    #tab-sujets.active { display: flex; }
    .sujets-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; flex-shrink: 0; }
    .sujets-toolbar label { font-size: 11px; color: #888; }
    .sujets-layout { display: flex; gap: 16px; flex: 1; min-height: 0; }
    .sujets-list-wrap { flex: 1; min-width: 0; overflow-y: auto; }
    .sujets-sidebar { width: 360px; flex-shrink: 0; overflow-y: auto; }
    .sujets-occurrence { border: 1px solid #e3e3e3; border-radius: 6px; padding: 10px 12px; margin-bottom: 8px; }
    .sujets-occurrence.posterieur { border-color: #e0a12e; background: #fdf6e8; }
    .sujets-occurrence-flag { color: #b5651d; font-weight: 600; font-size: 11px; }
    .sujets-panel { border: 1px solid #e3e3e3; border-radius: 6px; padding: 14px; }
    .sujets-panel-empty { color: #999; font-size: 12px; }
    .sujets-action-apercu { background: #f7f7f7; border: 1px dashed #ccc; border-radius: 6px; padding: 10px; margin: 10px 0; font-size: 12px; }
    .sujets-action-confirmer { background: #c0392b; color: #fff; border: none; border-radius: 4px; padding: 8px 14px; cursor: pointer; font-weight: 600; }
    .sujets-action-confirmer:hover { background: #a93226; }
    .sujets-action-annuler { background: #eee; border: none; border-radius: 4px; padding: 8px 14px; cursor: pointer; margin-left: 8px; }
    .injev-banner { margin: 0 0 12px; padding: 8px 12px; border-radius: 6px; background: #eef4fb; border: 1px solid #cfe0f0; font-size: 0.9em; color: #34495e; flex-shrink: 0; }
    .injev-panel { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 14px; font-size: 12px; }
    .injev-panel-empty { color: #999; font-style: italic; }
    .injev-panel-title { font-weight: 700; font-size: 13px; margin-bottom: 12px; }
    .injev-panel-section { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #eee; }
    .injev-panel-section:last-child { border-bottom: none; }
    .injev-panel-section label { display: block; font-size: 11px; color: #666; margin-bottom: 4px; }
    .injev-panel-section input[type="text"], .injev-panel-section select, .injev-panel-section textarea {
      width: 100%; box-sizing: border-box; font-family: 'JetBrains Mono', monospace;
      padding: 5px 8px; border: 1px solid #ccc; border-radius: 4px; background: #fff; font-size: 12px;
    }
    .injev-panel-section textarea { resize: vertical; }
    .injev-panel-hint { font-size: 10px; color: #999; margin-top: 3px; }
    .injev-chips-box { display: flex; flex-wrap: wrap; gap: 6px; }
    .injev-chip {
      display: flex; align-items: center; gap: 4px; border: 1px solid #ddd; border-radius: 12px;
      padding: 3px 9px; font-size: 11px; cursor: pointer; user-select: none;
    }
    .injev-chip input { margin: 0; cursor: pointer; }
    .injev-chip.active { border-color: #3b6fd4; background: #eef4fa; color: #2a52a8; font-weight: 600; }
    .injev-checkbox-row { display: flex; align-items: center; gap: 6px; }
    .injev-panel-btn {
      padding: 6px 14px; border: 1px solid #3b6fd4; border-radius: 4px; background: #fff;
      color: #2a52a8; font-size: 12px; cursor: pointer; font-weight: 600;
    }
    .injev-panel-btn:hover { background: #3b6fd4; color: #fff; }
    .injev-panel-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .injev-panel-btn-secondary { background: #fff; border-color: #ccc; color: #555; font-weight: normal; }
    .injev-panel-msg { font-size: 11px; margin-top: 8px; }
    .injev-panel-msg.ok { color: #2e7d4f; }
    .injev-panel-msg.error { color: #c0392b; }
    .injev-panel-msg.loading { color: #888; font-style: italic; }
    .injev-result-box { margin-top: 10px; padding: 8px 10px; border-radius: 4px; font-size: 11px; line-height: 1.5; }
    .injev-result-box.ok { background: #eaf7ef; border: 1px solid #b7e0c4; color: #2e7d4f; }
    .injev-result-box.error { background: #fdeceb; border: 1px solid #f0b8b0; color: #c0392b; }
  </style>
</head>
<body>
<div id="app">

  <!-- ══ SIDEBAR ══════════════════════════════════════════ -->
  <aside id="sidebar">

    <div id="masthead">
      <div class="eyebrow">Pipeline</div>
      <div class="title">Ourrassol 2098</div>
    </div>

    <div id="llm-selector">
      <div class="llm-label">Fournisseur LLM</div>
      <div class="llm-row">
        <select id="llm-provider" title="Fournisseur">
          <option value="mistral">Mistral</option>
          <option value="claude">Claude</option>
        </select>
        <select id="llm-model" title="Modèle">
          <option>—</option>
        </select>
        <span id="llm-cost-badge" class="cost-badge cost-eco">éco</span>
      </div>
      <label class="llm-force-row" id="llm-force-row" for="llm-force-override">
        <input type="checkbox" id="llm-force-override">
        <span>Forcer ce modèle pour le prochain lancement</span>
      </label>
      <div id="llm-routing-note">Sinon : routing automatique par tier (voir llm_client.py)</div>
    </div>

    <nav id="nav">
      <!-- Construit par app.js -->
    </nav>

  </aside>

  <!-- ══ POIGNÉE DE REDIMENSIONNEMENT (ajoutée le 31 juillet 2026) ══ -->
  <div id="sidebar-resizer" title="Glisser pour élargir/réduire le panneau"></div>

  <!-- ══ ZONE PRINCIPALE ══════════════════════════════════ -->
  <main id="main">

    <div id="mois-parution-banner">📅 Mois de parution : chargement…</div>

    <div id="llm-force-banner">
      <span class="icon">⚠</span>
      <span>Modèle forcé actif : <strong id="llm-force-banner-text">—</strong> — tous les scripts lancés ignorent le routing par tier tant que ce n'est pas décoché.</span>
      <button id="llm-force-banner-undo">Désactiver</button>
    </div>


    <!-- Vue script -->
    <div id="script-view" style="display:none; flex-direction:column; flex:1; overflow:hidden;">

      <!-- Topbar avec nom script + bouton Lancer -->
      <div id="script-topbar">
        <span class="script-name" id="form-script-title">—</span>
        <span class="script-sep">—</span>
        <span class="script-desc-top" id="form-script-desc"></span>
        <button id="btn-stop">■ Stop</button>
        <button id="btn-run">□ Lancer</button>
      </div>

      <!-- Corps : formulaire + log -->
      <div id="script-body">

        <div id="form-panel">
          <div id="form-body">
            <div style="padding:20px;color:var(--text-muted);font-size:12px">
              Sélectionnez un script dans la barre latérale.
            </div>
          </div>
          <div id="form-footer"></div>
        </div>

        <div id="log-panel">
          <div id="log-header">
            <span class="log-title">Sortie</span>
            <span id="log-status" class="log-status idle">En attente</span>
            <a href="#" id="log-clear">Effacer</a>
          </div>
          <pre id="log-output"><span class="cursor-blink" id="log-cursor" style="display:none"></span># Lance un script pour voir les logs ici</pre>
        </div>

      </div>
    </div>

    <!-- ── Tableau de bord ─────────────────────── -->
    <div id="tab-dashboard" class="tab-content">
      <div class="tab-page-title">Tableau de bord</div>
      <div class="dashboard-grid" id="dashboard-grid">
        <div class="stat-card"><div class="card-title">Chargement…</div></div>
      </div>
    </div>

    <!-- ── Revue ──────────────────────────────── -->
    <div id="tab-review" class="tab-content">
      <div class="tab-page-title">Revue</div>
      <div class="review-empty">Chargement…</div>
    </div>

    <!-- ── Config ─────────────────────────────── -->
    <div id="tab-config" class="tab-content">
      <div class="tab-page-title">Configuration</div>

      <h3>Vault</h3>
      <div class="config-field">
        <label for="cfg-vault-root">vault_root</label>
        <input type="text" id="cfg-vault-root" placeholder="/chemin/absolu/vers/le/vault">
      </div>
      <div class="config-field">
        <label for="cfg-pipeline-dir">pipeline_dir</label>
        <input type="text" id="cfg-pipeline-dir" placeholder="/chemin/absolu/vers/le/vault/generator">
      </div>
      <div class="config-field">
        <label for="cfg-default-scenario">Scénario par défaut</label>
        <select id="cfg-default-scenario"></select>
      </div>

      <h3>LLM</h3>
      <div class="config-field">
        <label for="cfg-llm-provider">Fournisseur par défaut</label>
        <select id="cfg-llm-provider">
          <option value="mistral">Mistral</option>
          <option value="claude">Claude</option>
        </select>
      </div>
      <div class="config-field">
        <label for="cfg-llm-model-mistral">Modèle Mistral par défaut</label>
        <input type="text" id="cfg-llm-model-mistral" placeholder="mistral-medium-latest">
      </div>
      <div class="config-field">
        <label for="cfg-llm-model-claude">Modèle Claude par défaut</label>
        <input type="text" id="cfg-llm-model-claude" placeholder="claude-sonnet-4-6">
      </div>

      <div class="config-actions">
        <button id="cfg-save" class="btn-primary">Sauvegarder</button>
        <button id="cfg-test-path" class="btn-secondary">Tester chemin</button>
      </div>
      <div id="cfg-message" class="config-msg"></div>
    </div>

    <!-- ── Carte ──────────────────────────────── -->
    <div id="tab-carte" class="tab-content">
      <div class="carte-toolbar">
        <span class="tab-page-title" style="margin:0">Carte géographique</span>
        <label for="carte-scenario" style="margin-left:16px;font-size:12px;color:#888">Scénario</label>
        <select id="carte-scenario"></select>
        <button id="carte-toggle-dessin" class="btn-secondary" style="margin-left:12px" onclick="toggleModeDessin()">✏️ Dessiner un overlay</button>
        <button id="carte-toggle-dessin-zone-complete" class="btn-secondary" style="margin-left:12px" onclick="toggleModeDessinZoneComplete()">🗺️ Dessiner une zone complète</button>
        <button id="carte-toggle-enrichissement" class="btn-secondary" style="margin-left:6px" onclick="openEnrichissementPanel()">🧬 Zones à enrichir</button>
        <button id="carte-toggle-overlays-liste" class="btn-secondary" style="margin-left:6px" onclick="openOverlaysListePanel()">🗑️ Gérer les overlays</button>
        <span id="carte-status" class="carte-status"></span>
      </div>
      <div id="carte-diagnostic" class="carte-diagnostic" style="display:none"></div>
      <div class="carte-layout">
        <div id="carte-map"></div>
        <div class="carte-sidebar">
          <div class="carte-search">
            <input type="text" id="carte-search-input" placeholder="🔍 Rechercher une zone (tous niveaux)…" autocomplete="off">
            <div id="carte-search-results"></div>
          </div>
          <div id="carte-legend" class="carte-legend"></div>
          <div id="carte-panel" class="carte-panel">
            <div class="carte-panel-empty">Clique sur un pays gris pour l'affecter à une zone.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Rédaction — journalistes & orateurs (point 3, 30 août 2026) ── -->
    <div id="tab-redaction" class="tab-content">
      <div class="redaction-toolbar">
        <span class="tab-page-title" style="margin:0">Rédaction — journalistes &amp; orateurs</span>
        <div class="redaction-filter-group">
          <label for="redaction-scenario">Scénario</label>
          <select id="redaction-scenario"><option value="">Tous</option></select>
        </div>
        <div class="redaction-filter-group">
          <label for="redaction-ligne">Ligne</label>
          <select id="redaction-ligne">
            <option value="">Toutes</option>
            <option value="pro_pouvoir">pro_pouvoir</option>
            <option value="opposition">opposition</option>
          </select>
        </div>
        <div class="redaction-filter-group">
          <label for="redaction-role">Rôle</label>
          <select id="redaction-role">
            <option value="">Tous</option>
            <option value="journaliste">Journaliste</option>
            <option value="orateur">Orateur</option>
          </select>
        </div>
        <div class="redaction-filter-group">
          <label for="redaction-ton-status">ton_personnel</label>
          <select id="redaction-ton-status">
            <option value="">Tous</option>
            <option value="vide">Vide seulement</option>
            <option value="rempli">Rempli seulement</option>
          </select>
        </div>
        <input type="text" id="redaction-search" placeholder="🔍 Nom…" autocomplete="off">
        <span id="redaction-count" class="redaction-count"></span>
      </div>
      <div class="redaction-layout">
        <div class="redaction-table-wrap">
          <div class="redaction-table-scroll">
            <table class="redaction-table">
              <colgroup>
                <col style="width:10%"><col style="width:8%"><col style="width:20%">
                <col style="width:7%"><col style="width:20%"><col style="width:8%">
                <col style="width:6%"><col style="width:8%"><col style="width:13%">
              </colgroup>
              <thead>
                <tr>
                  <th data-sort="scenario">Scénario</th>
                  <th data-sort="ligne">Ligne</th>
                  <th data-sort="zone_nom">Zone</th>
                  <th data-sort="type_diffusion">Diffusion</th>
                  <th data-sort="nom">Nom</th>
                  <th data-sort="role">Rôle</th>
                  <th data-sort="seniorite">Sén.</th>
                  <th data-sort="nb_articles">Articles</th>
                  <th data-sort="ton_personnel">ton_personnel</th>
                </tr>
              </thead>
              <tbody id="redaction-tbody"></tbody>
            </table>
          </div>
          <div class="redaction-pagination">
            <span id="redaction-range"></span>
            <div class="redaction-pagination-btns">
              <button id="redaction-prev">← Page précédente</button>
              <span id="redaction-page-label"></span>
              <button id="redaction-next">Page suivante →</button>
            </div>
          </div>
        </div>
        <div id="redaction-resizer" title="Glisser pour élargir/réduire le panneau"></div>
        <div class="redaction-sidebar">
          <div id="redaction-panel" class="redaction-panel">
            <div class="redaction-panel-empty">Clique sur une ligne pour voir/éditer sa fiche.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Articles — inventaire complet (5 septembre 2026, chantier
         "Suite narrative des événements") ── -->
    <div id="tab-articles" class="tab-content">
      <div class="articles-toolbar">
        <span class="tab-page-title" style="margin:0">Articles — inventaire complet</span>
        <div class="articles-filter-group">
          <label for="articles-scenario">Scénario</label>
          <select id="articles-scenario"><option value="">Tous</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="articles-thematique">Thématique</label>
          <select id="articles-thematique"><option value="">Toutes</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="articles-ligne">Ligne</label>
          <select id="articles-ligne">
            <option value="">Toutes</option>
            <option value="pro_pouvoir">pro_pouvoir</option>
            <option value="opposition">opposition</option>
          </select>
        </div>
        <div class="articles-filter-group">
          <label for="articles-evenement-force"><input type="checkbox" id="articles-evenement-force" style="margin:0"> Avec événement forcé seulement</label>
        </div>
        <div class="articles-filter-group">
          <label for="articles-mois-actif"><input type="checkbox" id="articles-mois-actif" style="margin:0"> Mois en cours seulement</label>
        </div>
        <div class="articles-filter-group">
          <label for="articles-basculement"><input type="checkbox" id="articles-basculement" style="margin:0"> Basculement narratif détecté</label>
        </div>
        <input type="text" id="articles-search" placeholder="🔍 Slug / chapo…" autocomplete="off">
        <span id="articles-count" class="articles-count"></span>
        <button id="articles-btn-rapport-md">Générer le rapport Markdown</button>
        <button id="articles-btn-lancer-basculements">Détecter les basculements narratifs</button>
      </div>
      <div id="articles-rapport-resultat" class="sujets-action-apercu" style="display:none;margin-bottom:10px"></div>
      <div id="articles-basculements-statut" style="font-size:11px;color:#888;margin-bottom:10px">Détection jamais lancée.</div>
      <div class="articles-layout">
        <div class="articles-table-wrap">
          <div class="articles-table-scroll">
            <table class="articles-table">
              <colgroup>
                <col style="width:16%"><col style="width:12%"><col style="width:14%">
                <col style="width:10%"><col style="width:28%"><col style="width:20%">
              </colgroup>
              <thead>
                <tr>
                  <th data-sort="scenario">Scénario</th>
                  <th data-sort="date_tri">Date</th>
                  <th data-sort="thematique">Thématique</th>
                  <th data-sort="ligne_editoriale">Ligne</th>
                  <th data-sort="slug">Slug</th>
                  <th data-sort="fichier">Fichier</th>
                </tr>
              </thead>
              <tbody id="articles-tbody"></tbody>
            </table>
          </div>
          <div class="articles-pagination">
            <span id="articles-range"></span>
            <div class="articles-pagination-btns">
              <button id="articles-prev">← Page précédente</button>
              <span id="articles-page-label"></span>
              <button id="articles-next">Page suivante →</button>
            </div>
          </div>
        </div>
        <div class="panel-resizer" id="articles-resizer" title="Glisser pour élargir/réduire le panneau"></div>
        <div class="articles-sidebar">
          <div id="articles-panel" class="articles-panel">
            <div class="articles-panel-empty">Clique sur une ligne pour voir le détail et agir dessus.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Instances (chantier "GUI Entités/Instances/Événements/Signaux",
         7 septembre 2026) -- même gabarit que #tab-articles ci-dessus ── -->
    <div id="tab-instances" class="tab-content">
      <div class="articles-toolbar">
        <span class="tab-page-title" style="margin:0">Instances — inventaire complet</span>
        <div class="articles-filter-group">
          <label for="instances-scenario">Scénario</label>
          <select id="instances-scenario"><option value="">Tous</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="instances-type">Type</label>
          <select id="instances-type"><option value="">Tous</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="instances-trajectoire">Trajectoire</label>
          <select id="instances-trajectoire"><option value="">Toutes</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="instances-transnationale"><input type="checkbox" id="instances-transnationale" style="margin:0"> Transnationales seulement</label>
        </div>
        <div class="articles-filter-group">
          <label for="instances-clandestine"><input type="checkbox" id="instances-clandestine" style="margin:0"> Clandestines seulement</label>
        </div>
        <input type="text" id="instances-search" placeholder="🔍 Nom / rôle…" autocomplete="off">
        <span id="instances-count" class="articles-count"></span>
        <button id="instances-btn-rapport-md">Générer le rapport Markdown</button>
      </div>
      <div id="instances-rapport-resultat" class="sujets-action-apercu" style="display:none;margin-bottom:10px"></div>
      <div class="articles-layout">
        <div class="articles-table-wrap">
          <div class="articles-table-scroll">
            <table class="articles-table">
              <colgroup>
                <col style="width:14%"><col style="width:22%"><col style="width:22%">
                <col style="width:14%"><col style="width:14%"><col style="width:14%">
              </colgroup>
              <thead>
                <tr>
                  <th data-sort="scenario">Scénario</th>
                  <th data-sort="name">Nom</th>
                  <th data-sort="entite_name">Entité parente</th>
                  <th data-sort="type_dans_scenario">Type</th>
                  <th data-sort="trajectoire">Trajectoire</th>
                  <th data-sort="zone">Zone</th>
                </tr>
              </thead>
              <tbody id="instances-tbody"></tbody>
            </table>
          </div>
          <div class="articles-pagination">
            <span id="instances-range"></span>
            <div class="articles-pagination-btns">
              <button id="instances-prev">← Page précédente</button>
              <span id="instances-page-label"></span>
              <button id="instances-next">Page suivante →</button>
            </div>
          </div>
        </div>
        <div class="panel-resizer" id="instances-resizer" title="Glisser pour élargir/réduire le panneau"></div>
        <div class="articles-sidebar">
          <div id="instances-panel" class="articles-panel">
            <div class="articles-panel-empty">Clique sur une ligne pour voir le détail.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Event_instances (chantier "GUI Entités/Instances/Événements/
         Signaux", 7 septembre 2026) -- même gabarit qu'Instances ── -->
    <div id="tab-event_instances" class="tab-content">
      <div class="articles-toolbar">
        <span class="tab-page-title" style="margin:0">Événements — inventaire complet</span>
        <div class="articles-filter-group">
          <label for="event-instances-scenario">Scénario</label>
          <select id="event-instances-scenario"><option value="">Tous</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="event-instances-portee">Portée</label>
          <select id="event-instances-portee"><option value="">Toutes</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="event-instances-type">Type</label>
          <select id="event-instances-type"><option value="">Tous</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="event-instances-impossible"><input type="checkbox" id="event-instances-impossible" style="margin:0"> Marqués impossible seulement</label>
        </div>
        <input type="text" id="event-instances-search" placeholder="🔍 Nom…" autocomplete="off">
        <span id="event-instances-count" class="articles-count"></span>
        <button id="event-instances-btn-rapport-md">Générer le rapport Markdown</button>
      </div>
      <div id="event-instances-rapport-resultat" class="sujets-action-apercu" style="display:none;margin-bottom:10px"></div>
      <div class="articles-layout">
        <div class="articles-table-wrap">
          <div class="articles-table-scroll">
            <table class="articles-table">
              <colgroup>
                <col style="width:14%"><col style="width:22%"><col style="width:22%">
                <col style="width:14%"><col style="width:14%"><col style="width:14%">
              </colgroup>
              <thead>
                <tr>
                  <th data-sort="scenario">Scénario</th>
                  <th data-sort="name">Nom</th>
                  <th data-sort="archetype_name">Archétype parent</th>
                  <th data-sort="portee">Portée</th>
                  <th data-sort="date">Date</th>
                  <th data-sort="custom">Custom</th>
                </tr>
              </thead>
              <tbody id="event-instances-tbody"></tbody>
            </table>
          </div>
          <div class="articles-pagination">
            <span id="event-instances-range"></span>
            <div class="articles-pagination-btns">
              <button id="event-instances-prev">← Page précédente</button>
              <span id="event-instances-page-label"></span>
              <button id="event-instances-next">Page suivante →</button>
            </div>
          </div>
        </div>
        <div class="panel-resizer" id="event-instances-resizer" title="Glisser pour élargir/réduire le panneau"></div>
        <div class="articles-sidebar">
          <div id="event-instances-panel" class="articles-panel">
            <div class="articles-panel-empty">Clique sur une ligne pour voir le détail.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Signaux faibles (chantier "GUI Entités/Instances/Événements/
         Signaux", 7 septembre 2026, dernier des 3 types) -- même gabarit
         que les 2 précédents ── -->
    <div id="tab-signaux" class="tab-content">
      <div class="articles-toolbar">
        <span class="tab-page-title" style="margin:0">Signaux faibles — inventaire complet</span>
        <div class="articles-filter-group">
          <label for="signaux-scenario">Scénario</label>
          <select id="signaux-scenario"><option value="">Tous</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="signaux-categorie">Catégorie</label>
          <select id="signaux-categorie"><option value="">Toutes</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="signaux-statut">Statut</label>
          <select id="signaux-statut"><option value="">Tous</option></select>
        </div>
        <div class="articles-filter-group">
          <label for="signaux-impact"><input type="checkbox" id="signaux-impact" style="margin:0"> Avec Impact chiffré seulement</label>
        </div>
        <input type="text" id="signaux-search" placeholder="🔍 Slug…" autocomplete="off">
        <span id="signaux-count" class="articles-count"></span>
        <button id="signaux-btn-rapport-md">Générer le rapport Markdown</button>
      </div>
      <div id="signaux-rapport-resultat" class="sujets-action-apercu" style="display:none;margin-bottom:10px"></div>
      <div class="articles-layout">
        <div class="articles-table-wrap">
          <div class="articles-table-scroll">
            <table class="articles-table">
              <colgroup>
                <col style="width:26%"><col style="width:18%"><col style="width:14%">
                <col style="width:28%"><col style="width:14%">
              </colgroup>
              <thead>
                <tr>
                  <th data-sort="slug">Slug</th>
                  <th data-sort="categorie">Catégorie</th>
                  <th data-sort="statut">Statut</th>
                  <th data-sort="scenarios_str">Scénarios</th>
                  <th data-sort="a_impact_chiffre">Impact chiffré</th>
                </tr>
              </thead>
              <tbody id="signaux-tbody"></tbody>
            </table>
          </div>
          <div class="articles-pagination">
            <span id="signaux-range"></span>
            <div class="articles-pagination-btns">
              <button id="signaux-prev">← Page précédente</button>
              <span id="signaux-page-label"></span>
              <button id="signaux-next">Page suivante →</button>
            </div>
          </div>
        </div>
        <div class="panel-resizer" id="signaux-resizer" title="Glisser pour élargir/réduire le panneau"></div>
        <div class="articles-sidebar">
          <div id="signaux-panel" class="articles-panel">
            <div class="articles-panel-empty">Clique sur une ligne pour voir le détail.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Résumés par scénario (demande de David, 7 septembre 2026) --
         gabarit carte, pas table+panneau (6 scénarios seulement) ── -->
    <div id="tab-resumes" class="tab-content">
      <div class="resumes-toolbar">
        <span class="tab-page-title" style="margin:0">Résumés par scénario</span>
        <button id="resumes-btn-tout-regenerer">Régénérer tous les scénarios (jusqu'à ~6 appels LLM)</button>
        <span id="resumes-statut" style="font-size:11px;color:#888"></span>
      </div>
      <div id="resumes-grid" class="resumes-grid"></div>
    </div>

    <!-- ── Chantiers (point 4.5, 26 juillet 2026) ── -->
    <div id="tab-chantiers" class="tab-content">
      <div class="chantiers-toolbar">
        <span class="tab-page-title" style="margin:0">Chantiers géographie</span>
        <label for="chantiers-scenario" style="font-size:12px;color:#888">Scénario</label>
        <select id="chantiers-scenario">
          <option value="">Tous</option>
        </select>
        <label for="chantiers-type" style="font-size:12px;color:#888">Type</label>
        <select id="chantiers-type">
          <option value="">Tous</option>
          <option value="pays_sans_zone">Pays sans zone</option>
          <option value="zone_suspecte">Zone suspecte</option>
        </select>
        <label for="chantiers-statut" style="font-size:12px;color:#888">Statut</label>
        <select id="chantiers-statut">
          <option value="a_traiter">À traiter</option>
          <option value="ignore">Ignorés</option>
          <option value="traite">Traités</option>
          <option value="">Tous</option>
        </select>
        <div class="chantiers-toolbar-spacer"></div>
        <span id="chantiers-count" class="chantiers-count"></span>
        <button id="chantiers-appliquer-tout" class="chantiers-btn chantiers-btn-primary">Appliquer les propositions approuvées</button>
      </div>
      <div id="chantiers-list"></div>
    </div>

    <!-- ── Audit & édition de sujets (5 septembre 2026, chantier "Suite
         narrative des événements", point B) ── -->
    <div id="tab-sujets" class="tab-content">
      <div class="sujets-toolbar">
        <span class="tab-page-title" style="margin:0">Audit par sujet (événements & entités)</span>
        <label for="sujets-scenario">Scénario</label>
        <select id="sujets-scenario">
          <option value="">— choisir —</option>
        </select>
        <label for="sujets-type">Type</label>
        <select id="sujets-type">
          <option value="evenement">Événement custom</option>
          <option value="entite">Entité</option>
        </select>
        <label for="sujets-slug">Sujet</label>
        <select id="sujets-slug">
          <option value="">— choisir un scénario d'abord —</option>
        </select>
        <input type="text" id="sujets-slug-manuel" placeholder="slug de l'entité (ex. directive_kontinuum_fortress_world)" style="display:none;min-width:280px">
      </div>
      <div id="sujets-banner" class="injev-banner" style="display:none"></div>
      <div class="sujets-layout">
        <div class="sujets-list-wrap" id="sujets-occurrences">
          <div class="sujets-panel-empty">Choisis un scénario, un type et un sujet pour voir ses occurrences.</div>
        </div>
        <div class="sujets-sidebar">
          <div id="sujets-panel" class="sujets-panel">
            <div class="sujets-panel-empty">Clique sur une occurrence pour la supprimer ou modifier sa date.</div>
          </div>
        </div>
      </div>
    </div>

  </main>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.js"></script>
<script>
  // Injectée par app.py depuis la variable d'environnement CARTO_API_KEY
  // (30 août 2026) -- jamais en dur dans app.js, jamais commitée. Chaîne
  // vide si la variable d'environnement n'est pas définie (app.js gère ce
  // cas -- voir initLeafletMap()).
  window.CARTO_API_KEY = {{ carto_api_key|tojson }};
</script>
<script src="{{ url_for('static', filename='app.js') }}"></script>
</body>
</html>
