          - sciences_technologies
          - medias_communication
          seniorite: 1
        - nom: Mariam Al-Mansoori
          thematiques:
          - environnement_climat
          - sante
          - meteo
          seniorite: 1
        - nom: Samer Khoury
          thematiques:
          - societe
          - education
