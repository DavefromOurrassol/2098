          seniorite: 1
        - nom: Miriam Ben-Ami
          thematiques:
          - environnement_climat
          - meteo
          - sante
          seniorite: 1
        - nom: Samir Haddad
          thematiques:
          - societe
          - education
          - petites_annonces_services
          - lifestyle_art_de_vivre
          seniorite: 1
        - nom: Rana al-Masri
          thematiques:
          - culture
          - musique
          - histoire_patrimoine
          - religion_spiritualite
          seniorite: 1
        - nom: Noura al-Sabah
          thematiques:
