          - sante
          - education
          - petites_annonces_services
          seniorite: 1
        - nom: Hery Andrianarivo
          thematiques:
          - culture
          - histoire_patrimoine
          - religion_spiritualite
          - musique
          seniorite: 1
        - nom: Toky Ratsimbazafy
          thematiques:
