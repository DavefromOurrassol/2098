def continent_pays(nom):
    s = slugify(nom)
    if "groenland" in s or "svalbard" in s:
        return "Arctique"
    s = slugify(re.split(r"[(/]", nom)[0])
    return PAYS_CONTINENT.get(s)


def continent_zone(slug, geo, forces, avec_methode=False):
    """Continent d'une zone : forçage manuel > majorité de ses pays > indice du nom > Monde.
    Une zone dont aucun continent ne réunit 40 % des pays (≥ 3 continents) est « Monde »."""
    r = lambda c, m: (c, m) if avec_methode else c
    if slug in forces:
        return r(forces[slug], "forcé")
    z = geo.get(slug, {})
    votes = Counter(c for c in (continent_pays(p) for p in z.get("pays", [])) if c)
    if votes:
        (c, n), total = votes.most_common(1)[0], sum(votes.values())
        if len(votes) >= 3 and n / total < 0.4:
            return r("Monde", "pays répartis sur plusieurs continents")
        return r(c, "pays")
    cle = slug + " " + slugify(z.get("nom", ""))
    for indice, c in INDICES_CONTINENT:
        if indice in cle:
            return r(c, f"sans pays, deviné d'après « {indice} »")
    return r("Monde", "sans pays, aucun indice")


