        shutil.rmtree(out_root)
    os.makedirs(out_root)
    open(marque, "w").write(dt.datetime.now().isoformat())
    open(os.path.join(out_root, "style.css"), "w", encoding="utf-8").write(CSS)

    forces = charger_forces_continents()
    liste, exclus, a_paraitre = publiables(articles, parution)
    chapos = charger_chapos()
    n_revue = 0
    pubs = defaultdict(list)
    for a in liste:
        c = chapos.get(cle_article(a))
        if c and c.get("empreinte") == empreinte(a["corps"]) and c.get("chapo"):
            a["chapo_aff"] = c["chapo"]   # chapô de la rédaction de la revue
