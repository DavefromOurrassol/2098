def scanner(scenarios, journaux, revues, geos):
    """Une entrée par article, avec 'statut' == 'ok' si publiable."""
    out = []
    for sc in scenarios:
        for f in sorted(glob.glob(os.path.join(VAULT, "articles", sc, "*.md"))):
            nom = os.path.basename(f)
            if nom.startswith("_"):
                continue
            fm, corps = lire_article(f)
            a = {"fichier": nom, "scenario": sc, "path": f}
            if fm is None:
                a["statut"] = "frontmatter illisible"
                out.append(a)
                continue
            lg = fm.get("ligne_editoriale")
            zone = fm.get("zone_principale") or ""
            a.update(fm=fm, corps=corps, ligne_editoriale=lg or "", zone_principale=zone)
            if lg not in LIGNES:
                a["statut"] = "ligne_editoriale absente"
            elif not zone:
                a["statut"] = "zone_principale vide"
            else:
                zj = ((journaux.get(sc) or {}).get(lg) or {}).get("zones") or {}
                zone_j, chemin = resoudre_journal(zone, zj, geos[sc])
                a["chemin_zones"] = " > ".join(chemin)
                if zone_j is None:
                    a["statut"] = ("zone absente de la géographie" if zone not in geos[sc]
                                   else "aucun journal sur la chaîne de zones")
                else:
                    j = zj[zone_j]
                    noms = {slugify(p["nom"]): p["nom"] for p in j.get("journalistes", [])}
                    js = fm.get("journaliste_slug") or ""
                    a.update(
                        statut="ok",
                        revue=revues[sc][lg]["nom"],
                        journal=j.get("nom", ""),
                        journal_ton=j.get("ton", ""),
                        # fiche publique (generate_journaux.py --fill-presentation) ; repli sur le ton
                        journal_presentation=j.get("presentation") or premiere_phrase(j.get("ton", "")),
                        journal_meta=" · ".join(str(x) for x in (
                            j.get("ville") or geos[sc].get(zone_j, {}).get("nom", zone_j),
                            j.get("periodicite"),
                            (langue_principale(j.get("langue_style")) or [None])[0]) if x),
                        journal_fondation=j.get("fondation"),
                        zone_journal=zone_j,
                        zone_journal_nom=geos[sc].get(zone_j, {}).get("nom", zone_j),
                        signature=noms.get(js, f"La rédaction de {j.get('nom', '')}"),
                        signature_source="journaliste" if js in noms else "rédaction",
                        langue_style=j.get("langue_style") or "",
                        traduction=mention_traduction(j.get("langue_style")),
                        chapo_vide="oui" if not fm.get("chapo") else "",
                        date=parse_date(fm, nom),
                    )
            out.append(a)
    return out


