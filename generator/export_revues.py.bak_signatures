def publiables(articles, parution):
    """Articles qui partent en ligne -> (liste, Counter des thèmes exclus, nb datés après la parution)."""
    liste, exclus, a_paraitre = [], Counter(), 0
    for a in articles:
        if a["statut"] != "ok":
            continue
        if a["fm"].get("thematique") in THEMES_EXCLUES:
            exclus[a["fm"].get("thematique")] += 1
            continue
        d = a.get("date")
        if parution and d and (d.year, d.month) > (parution.year, parution.month):
            a_paraitre += 1  # daté après le mois de parution : pas encore paru
            continue
        liste.append(a)
    return liste, exclus, a_paraitre


def build(articles, scenarios, revues, journaux, geos, out_root, parution):
    marque = os.path.join(out_root, ".export_revues")
