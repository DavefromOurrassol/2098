def main():
    ap = argparse.ArgumentParser(description="Audit et génération du site des 12 revues")
    ap.add_argument("--scenario", choices=SCENARIOS)
    ap.add_argument("--detail", action="store_true", help="liste les articles non publiables")
    ap.add_argument("--csv", metavar="FICHIER", help="écrit une ligne par article")
    ap.add_argument("--build", action="store_true", help="génère le site statique")
    ap.add_argument("--out", default=os.path.join(VAULT, "site"), help="dossier de sortie (défaut : site/)")
    ap.add_argument("--mois", metavar="AAAA-MM", help="mois de parution (défaut : state/editions.json)")
    ap.add_argument("--continents", action="store_true", help="affiche le continent attribué à chaque zone de journal")
    args = ap.parse_args()

    journaux = yaml.safe_load(open(trouver("journaux.yaml"), encoding="utf-8"))
    revues = yaml.safe_load(open(trouver("revues.yaml"), encoding="utf-8"))
    scenarios = [args.scenario] if args.scenario else SCENARIOS
    geos = {sc: charger_geo(sc) for sc in scenarios}
    articles = scanner(scenarios, journaux, revues, geos)

    if args.continents:
        forces = charger_forces_continents()
        for sc in scenarios:
            zj = set()
            for lg in LIGNES:
                zj |= set((((journaux.get(sc) or {}).get(lg) or {}).get("zones") or {}).keys())
            print(f"\n=== {sc} ===")
            par_c = defaultdict(list)
            for z in zj:
                par_c[continent_zone(z, geos[sc], forces.get(sc) or {})].append(z)
            for c in CONTINENTS:
                if par_c.get(c):
                    print(f"  {c:13} " + ", ".join(sorted(par_c[c])))
        return
    if args.build:
        build(articles, scenarios, revues, journaux, geos, os.path.abspath(args.out),
              mois_parution(args.mois))
    else:
        audit(articles, scenarios, revues, args.detail, args.csv)


if __name__ == "__main__":
    main()
