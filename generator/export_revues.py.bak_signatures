    os.makedirs(os.path.join(out_dir, "rubriques"), exist_ok=True)

    # slugs uniques
    vus = set()
    for a in arts:
        base = slugify(a["fm"].get("slug") or a["fichier"][:-3])[:90] or "article"
        s, i = base, 2
        while s in vus:
            s, i = f"{base}_{i}", i + 1
        vus.add(s)
        a["page"] = s
        a["titre"], a["blocs"] = nettoyer_corps(a["corps"], "")
        if not a["titre"]:
            a["titre"] = (a["fm"].get("chapo") or s.replace("_", " "))[:120]
        a["theme"] = THEMES.get(a["fm"].get("thematique"), "")

    # Toutes les zones qui ont un journal dans ce camp, et toutes les thématiques
    # publiables, même vides aujourd'hui (décision du 3 oct : le volume s'équilibrera).
    zone_nom = {z: geo.get(z, {}).get("nom", z) for z in zones_journaux}
    zones = Counter({z: 0 for z in zones_journaux})
    zones.update(a["zone_journal"] for a in arts)
    zone_cont = {z: continent_zone(z, geo, forces) for z in zones_journaux}
    conts = [c for c in CONTINENTS if c in zone_cont.values()]
    themes = Counter({t: 0 for t in THEMES if t not in THEMES_EXCLUES})
    themes.update(a["fm"].get("thematique") for a in arts if a["theme"])

    d0 = parution  # mois de parution global (state/editions.json)
    num = numero(rv, d0) if d0 else None
    entete_num = (f'N° {num} · ' if num else '') + (f'{MOIS_NOMS[d0.month].capitalize()} {d0.year}' if d0 else '')

    def nav(prefix):
        l1 = "".join(f'<a href="{prefix}rubriques/continent_{slugify(c)}.html">{e(c)}</a>' for c in conts)
