def audit(articles, scenarios, revues, detail, csv_path):
    par_revue = defaultdict(Counter)
    problemes = defaultdict(list)
    for a in articles:
        sc, lg, st = a["scenario"], a.get("ligne_editoriale"), a["statut"]
        cle = f"{sc}/{lg}" if lg in LIGNES else f"{sc}/?"
        par_revue[cle][st] += 1
        if st == "ok":
            par_revue[cle]["signé " + a["signature_source"]] += 1
        else:
            problemes[st].append(f"{sc}/{a['fichier']}")

    ok = sum(1 for a in articles if a["statut"] == "ok")
    print(f"\n=== Audit de publication — {len(articles)} articles, {ok} publiables ===\n")
    print(f"{'revue':48} {'publiables':>10} {'signés':>7} {'rédac.':>7} {'refusés':>8}")
    for sc in scenarios:
        for lg in LIGNES + ["?"]:
            c = par_revue.get(f"{sc}/{lg}")
            if not c:
                continue
            nom = revues[sc][lg]["nom"] if lg in LIGNES else "(ligne inconnue)"
            refus = sum(v for k, v in c.items()
                        if k not in ("ok", "signé journaliste", "signé rédaction"))
            print(f"{sc + ' · ' + nom:48} {c['ok']:>10} {c['signé journaliste']:>7} "
                  f"{c['signé rédaction']:>7} {refus:>8}")
    if problemes:
        print("\nNon publiables, par cause :")
        for cause, liste in sorted(problemes.items(), key=lambda x: -len(x[1])):
            print(f"  {len(liste):>4}  {cause}")
            if detail:
                for n in liste:
                    print(f"          {n}")
    if csv_path:
        champs = ["scenario", "fichier", "statut", "ligne_editoriale", "zone_principale",
                  "chemin_zones", "zone_journal", "revue", "journal", "signature",
                  "signature_source", "traduction", "chapo_vide"]
        with open(csv_path, "w", newline="", encoding="utf-8") as fh:
            w = csv.DictWriter(fh, fieldnames=champs, extrasaction="ignore")
            w.writeheader()
            w.writerows(articles)
        print(f"\nCSV écrit : {csv_path}")


