        else:
            a["chapo_aff"] = a["fm"].get("chapo") or ""   # repli : chapô du journal
        pubs[(a["scenario"], a["ligne_editoriale"])].append(a)

    print(f"\n=== Génération du site dans {out_root} ===")
    print(f"    Chapôs de rédaction : {n_revue} / {len(liste)} articles "
          f"(les autres affichent le chapô du journal ; voir chapos_revues.py)")
    if parution:
        print(f"    Mois de parution : {MOIS_NOMS[parution.month]} {parution.year}"
              f" — {a_paraitre} article(s) daté(s) après, non publié(s)\n")
    kiosque = []
    for sc in scenarios:
        for lg in LIGNES:
            rv = dict(revues[sc][lg])
            rv["reseau_nom"] = "Membre du " + ((journaux.get(sc) or {}).get(lg, {}).get("_reseau", {}).get("nom") or "réseau")
            arts = pubs.get((sc, lg), [])
            dossier = slugify(rv["nom"])
            if not arts:
                print(f"  {rv['nom']:34} aucun article publiable, revue non générée")
                continue
            zj = ((journaux.get(sc) or {}).get(lg) or {}).get("zones") or {}
            n = construire_revue(os.path.join(out_root, dossier), sc, lg, rv, arts, zj, geos[sc], parution,
                                 forces.get(sc) or {})
            kiosque.append((sc, lg, rv, dossier, n))
            print(f"  {rv['nom']:34} {n:>4} articles → {dossier}/")
    # Zones dont le continent n'est pas sûr : à vérifier, ou à fixer dans continents_zones.yaml
    douteuses = []
    for sc in scenarios:
        zj = set()
        for lg in LIGNES:
            zj |= set((((journaux.get(sc) or {}).get(lg) or {}).get("zones") or {}).keys())
        for z in sorted(zj):
            c, m = continent_zone(z, geos[sc], forces.get(sc) or {}, avec_methode=True)
            if m not in ("pays", "forcé"):
                douteuses.append(f"{sc}/{z} → {c} ({m})")
    if douteuses:
        print(f"\n  ⚠ {len(douteuses)} zone(s) classée(s) sans certitude "
              f"(à fixer si besoin dans generator/continents_zones.yaml) :")
        for d in douteuses:
            print(f"      {d}")
    if exclus:
        print("\n  Non publiés (thématiques exclues) : " +
              ", ".join(f"{THEMES[t]} {n}" for t, n in exclus.items()))

    # ── Kiosque (hors fiction) ──
    blocs = []
    for sc in scenarios:
        cartes = "".join(
            f'<div class="rv"><div class="kick-s">{"Pro-pouvoir" if lg == "pro_pouvoir" else "Opposition"}</div>'
            f'<a class="t" href="{d}/index.html">{e(rv["nom"])}</a>'
            f'<div class="src">{e(rv.get("sous_titre", ""))}</div>'
            f'<div class="src">{n} articles · fondée en {e(str(rv.get("fondation", "")))} · {e(str(rv.get("ville_siege", "")))}</div></div>'
            for s, lg, rv, d, n in kiosque if s == sc)
        if cartes:
            blocs.append(f'<section><h2 class="sec-t">{e(sc.replace("_", " ").capitalize())}</h2>'
                         f'<div class="kiosque" style="margin-top:20px">{cartes}</div></section>')
    corps = ('<header class="mast"><div class="titre" style="font-size:clamp(36px,6vw,64px)">Ourrassol 2098</div>'
             '<div class="devise">Le kiosque · six mondes, douze revues</div></header>'
             f'<main class="wrap">{"".join(blocs)}</main>'
             '<footer><div class="wrap"><span>Ourrassol 2098 · œuvre de fiction</span></div></footer>')
    open(os.path.join(out_root, "index.html"), "w", encoding="utf-8").write(
        page("Ourrassol 2098 — Kiosque", corps, "style.css", "#2335A8"))
    print(f"\n  Kiosque : {os.path.join(out_root, 'index.html')}")


def mois_parution(force=None):
    """Mois de parution global : --mois AAAA-MM, sinon edition_active de state/editions.json."""
    if force:
        a, m = force.split("-")
        return dt.date(int(a), int(m), 1)
    import json
    candidats = [os.path.join(VAULT, "state", "editions.json"),
                 os.path.join(GEN_DIR, "state", "editions.json")]
    candidats += [h for h in glob.glob(os.path.join(VAULT, "**", "editions.json"), recursive=True)
                  if ".bak" not in h and h not in candidats]
    p = next((c for c in candidats if os.path.exists(c)), None)
    if not p:
        print("⚠ editions.json introuvable dans le vault : aucun filtre de date appliqué")
        return None
    try:
        ed = json.load(open(p, encoding="utf-8"))["edition_active"]
        return dt.date(int(ed["annee"]), int(ed["mois"]), 1)
    except Exception as ex:
        print(f"⚠ Mois de parution illisible ({p} : {type(ex).__name__} {ex}) : aucun filtre de date appliqué")
        return None


