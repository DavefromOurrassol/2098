def slugify(s):
    s = unicodedata.normalize("NFKD", str(s)).encode("ascii", "ignore").decode().lower()
    return re.sub(r"[^a-z0-9]+", "_", s).strip("_")


def trouver(nom):
    """Cherche un fichier dans generator/ puis dans tout le vault."""
    for base in (GEN_DIR, VAULT):
        p = os.path.join(base, nom)
        if os.path.exists(p):
            return p
    hits = [h for h in glob.glob(os.path.join(VAULT, "**", nom), recursive=True)
            if ".bak" not in h]
    if not hits:
        sys.exit(f"❌ {nom} introuvable dans le vault ({VAULT})")
    return hits[0]


def lire_article(path):
    """-> (frontmatter dict | None, corps markdown)"""
    try:
        txt = open(path, encoding="utf-8").read()
    except Exception:
        return None, ""
    m = re.match(r"---\n(.*?)\n---\n?", txt, re.S)
    if not m:
        return None, txt
    try:
        fm = yaml.safe_load(m.group(1))
    except Exception:
        return None, ""
    return (fm if isinstance(fm, dict) else None), txt[m.end():]


def charger_geo(scenario):
    """slug -> {'parent': slug|None, 'nom': str}"""
    fm, _ = lire_article(os.path.join(VAULT, "geographie", f"{scenario}.md"))
    geo = {}
    for z in (fm or {}).get("zones") or []:
        if isinstance(z, dict) and z.get("slug"):
            p = z.get("parent")
            nom = re.sub(r"\s*\(.*?\)", "", z.get("nom") or z["slug"]).strip()  # « Israël (Pôle …) » -> « Israël »
            pays = [o.get("entite") for o in (z.get("origine_reelle") or [])
                    if isinstance(o, dict) and o.get("type_entite") == "pays" and o.get("entite")]
            geo[z["slug"]] = {"parent": str(p).strip("[]") if p else None, "nom": nom, "pays": pays}
    return geo


def resoudre_journal(zone, zones_journaux, geo):
    """Remonte la chaîne des parents jusqu'à une zone qui a un journal."""
    chemin, cur, vus = [zone], zone, set()
    while cur not in zones_journaux:
        if cur in vus or cur not in geo or not geo[cur]["parent"]:
            return None, chemin
        vus.add(cur)
        cur = geo[cur]["parent"]
        chemin.append(cur)
    return cur, chemin


def langue_principale(langue_style):
    """-> (nom, élidé) ou None. Le mot de langue le plus tôt dans la phrase."""
    s = (langue_style or "").lower()
    meilleur = None
    for mot, val in LANGUES.items():
        m = re.search(r"(?<![a-zà-ÿ])" + re.escape(mot), s)
        if m and (meilleur is None or m.start() < meilleur[0]):
            meilleur = (m.start(), val)
    return meilleur[1] if meilleur else None


def mention_traduction(langue_style):
    lp = langue_principale(langue_style)
    if not lp or lp[0] == "français":
        return ""
    nom, elide = lp
    return f"Traduit de l'{nom}" if elide else f"Traduit du {nom}"


def parse_date(fm, fichier):
    """date_publication > date_evenement > nom de fichier ; -> date ou None"""
    for v in (fm.get("date_publication"), fm.get("date_evenement")):
        if isinstance(v, (dt.date, dt.datetime)):
            return v if isinstance(v, dt.date) else v.date()
        if v:
            s = slugify(str(v))
            m = re.match(r"(\d{1,2})_([a-z]+)_(\d{4})", s)
            if m and m.group(2) in MOIS:
                try:
                    return dt.date(int(m.group(3)), MOIS[m.group(2)], int(m.group(1)))
                except ValueError:
                    pass
            m = re.match(r"(\d{4})_(\d{2})_(\d{2})", s)
            if m:
                try:
                    return dt.date(*map(int, m.groups()))
                except ValueError:
                    pass
    m = re.search(r"_(\d{1,2})([a-z]+)(\d{4})\.md$", fichier)
    if m and m.group(2) in MOIS:
        try:
            return dt.date(int(m.group(3)), MOIS[m.group(2)], int(m.group(1)))
        except ValueError:
            pass
    return None


def empreinte(corps):
    """Empreinte du texte d'un article : un chapô de revue n'est réutilisé que si le texte n'a pas changé."""
    import hashlib
    return hashlib.sha1((corps or "").encode("utf-8")).hexdigest()[:16]


