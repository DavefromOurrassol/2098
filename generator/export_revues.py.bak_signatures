RE_DATE_SEULE = re.compile(r"^\*{0,2}_?\d{1,2}(er)? \w+ \d{4}_?\*{0,2}$")


def nettoyer_corps(corps, titre_fm=""):
    """-> (titre, liste de blocs markdown) ; retire titre, date, signature, 'Voir aussi'."""
    lignes = corps.strip().split("\n")

    # 1. Bloc final après le dernier séparateur '---' (Voir aussi, signature égarée…)
    for i in range(len(lignes) - 1, -1, -1):
        if lignes[i].strip() in ("---", "***", "___"):
            reste = "\n".join(lignes[i + 1:])
            if len(reste) < 600 or "[[" in reste or "Voir aussi" in reste:
                lignes = lignes[:i]
            break

    # 2. Titre : première ligne non vide en gras
    titre = ""
    while lignes and not lignes[0].strip():
        lignes.pop(0)
    if lignes:
        m = re.match(r"^\s*(#+\s*)?\*{0,2}(.+?)\*{0,2}\s*$", lignes[0])
        brut = lignes[0].strip()
        if brut.startswith("**") or brut.startswith("#"):
            titre = m.group(2).strip().strip("«»\"“” ").strip()
            lignes.pop(0)

    # 3. Lignes d'en-tête : date seule, signature courte avec tiret
    tete = 0
    while lignes and tete < 6:
        l = lignes[0].strip()
        if not l:
            lignes.pop(0)
            continue
        court = len(l) < 140 and not l.rstrip("*_ ").endswith((".", "?", "!", "»"))
        if RE_DATE_SEULE.match(l) or (court and re.search(r"\s[—–-]\s", l)) \
                or (court and "Réseau" in l):
            lignes.pop(0)
            tete += 1
            continue
        break

    texte = "\n".join(lignes).strip()
    blocs = [b.strip() for b in re.split(r"\n\s*\n", texte) if b.strip()]
    return titre or titre_fm, blocs


def inline(md):
    """markdown inline minimal -> html (texte déjà échappé ici)."""
    s = html.escape(md, quote=False)
    s = re.sub(r"\[\[([^\]|]+)\|([^\]]+)\]\]", r"\2", s)      # [[slug|alias]] -> alias
    s = re.sub(r"\[\[[^\]]+\]\]", "", s)                       # [[slug]] -> rien
    s = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<em>\1</em>", s)
    s = re.sub(r"(?<![\w_])_(?!\s)(.+?)(?<!\s)_(?![\w_])", r"<em>\1</em>", s)
    return s


def blocs_html(blocs):
    out = []
    for b in blocs:
        m = re.match(r"^(#{1,6})\s+(.*)$", b)
        if m:
            out.append(f"<h2>{inline(m.group(2))}</h2>")
        elif all(l.strip().startswith(("- ", "* ")) for l in b.split("\n")):
            items = "".join(f"<li>{inline(l.strip()[2:])}</li>" for l in b.split("\n"))
            out.append(f"<ul>{items}</ul>")
        elif b.startswith(">"):
            q = " ".join(l.lstrip("> ").strip() for l in b.split("\n"))
            out.append(f"<blockquote>{inline(q)}</blockquote>")
        else:
            out.append(f"<p>{inline(' '.join(l.strip() for l in b.split(chr(10))))}</p>")
    return "\n".join(out)


def premiere_phrase(s):
    s = (s or "").strip()
    m = re.match(r"(.+?[.!?])(\s|$)", s)
    return m.group(1) if m else s


