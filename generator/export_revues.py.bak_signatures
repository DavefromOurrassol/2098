        lire = "".join(f'<a href="{x["page"]}.html" style="font-size:18px;font-weight:600;line-height:1.25">'
                       f'{e(x["titre"])}</a>' for x in voisins)
        photo = ('<div class="photo" role="img" aria-label="Photo à venir" style="margin-bottom:20px"></div>'
                 if fm.get("a_une_photo") else "")
        corps = [mast_mini("../"), '<main class="wrap">',
                 f'<div class="fil"><a href="../rubriques/continent_{slugify(zone_cont[a["zone_journal"]])}.html">{e(zone_cont[a["zone_journal"]])}</a>'
                 f'<span aria-hidden="true">›</span><a href="../rubriques/{a["zone_journal"]}.html">{e(a["zone_journal_nom"])}</a>'
                 + (f'<span aria-hidden="true">›</span><a href="../rubriques/theme_{fm.get("thematique")}.html">{e(a["theme"])}</a>' if a["theme"] else "")
                 + '</div>',
                 f'<div class="art-tete"><h1>{e(a["titre"])}</h1>'
                 + (f'<p class="chapo">{inline(a["chapo_aff"])}</p>' if a["chapo_aff"] else "") + '</div>',
                 f'<div class="byline"><strong style="font-weight:600">{e(a["signature"])}</strong>'
                 f'<span><em style="font-style:normal;font-weight:600">{e(a["journal"])}</em></span>'
                 f'<span style="color:var(--muted)">Paru le {e(date_fr(a["date"]))}</span>'
                 + (f'<span class="trad">{e(a["traduction"])}</span>' if a["traduction"] else "") + '</div>',
                 f'<div class="art-corps"><article>{photo}{blocs_html(a["blocs"])}'
                 f'<div class="pied-art">{e(a["signature"])} · Publié dans <em>{e(a["journal"])}</em> '
                 f'le {e(date_fr(a["date"]))}</div></article>'
                 f'<aside><section class="fiche"><h2 class="sec-t" style="border:0;padding:0">La source</h2>'
                 f'<div class="nom">{e(a["journal"])}</div><div style="color:var(--muted)">{e(a["journal_meta"])}</div>'
                 f'<p>{inline(a["journal_presentation"])}</p>'
                 + (f'<div style="color:var(--muted)">Fondé en {e(str(a["journal_fondation"]))}</div>' if a["journal_fondation"] else "") +
                 f'<div style="color:var(--muted)">{e((rv.get("reseau_nom") or ""))}</div></section>'
                 + (f'<section><h2 class="sec-t">Mots-clés</h2><div class="tags" style="margin-top:14px">{tags}</div></section>' if tags else "")
                 + (f'<section style="display:flex;flex-direction:column;gap:14px"><h2 class="sec-t">Lire aussi</h2>{lire}</section>' if lire else "")
