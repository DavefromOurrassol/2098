# evenements_custom/queue.yaml
#
# Ajoute ici tes idées d'événements custom (observations de l'actualité,
# idées narratives...). Lance ensuite :
#
#   python3 generator/inject_custom_events.py            ← injection réelle
#   python3 generator/inject_custom_events.py --dry-run  ← test sans écriture
#
# CHAMPS :
#   id                    : identifiant court lisible (lettres, chiffres, underscores)
#   description           : l'idée en langage naturel, quelques phrases suffisent
#   portee                : locale | regionale | continentale | globale
#   date_approximative     : année 2025-2098 (peut varier de +/-10 ans par scénario ;
#                            2098 = année finale de la fiction, borne mise à jour le
#                            6 septembre 2026, voir clamp_date_dans_plage())
#   intensite              : faible | modérée | forte | majeure
#                            (la FORCE de l'événement, oriente le delta_level)
#   persistance            : optionnel. ephemere | normale | durable | permanente
#                            (la DURÉE de l'effet chiffré après sa montée :
#                            demi-vie 10 ans / défaut du type / 40 ans / aucune
#                            décroissance -- valeurs réglables dans dynamique.py,
#                            table PERSISTANCE). Absent = normale. Modifiable
#                            après coup dans chaque event_instances/*.md.
#   scenarios             : liste de scénarios à couvrir, ou null pour les 6 par défaut
#                            (valeurs : breakdown, fortress_world, new_sustainability,
#                            eco_communalism, policy_reform, reference)
#   variables_hint         : optionnel. null si tu ne sais pas — le LLM choisit
#                            automatiquement. Sinon une variable (chaîne) ou
#                            plusieurs (liste) que tu IMPOSES comme impactées.
#                            Variables disponibles :
#                              systeme_economique_redistribution | gouvernance_institutions
#                              geopolitique_conflits | valeurs_culture_tempo_sociale
#                              organisation_territoires | sante_biotechnologies
#                              frontieres_du_systeme | technologie_information
#                              climat_environnement_global | energie_ressources_critiques
#                              demographie_mobilite_humaine | systemes_productifs_travail
#   variables_hint_count   : optionnel, entier 1-4. Plafond du nombre total de
#                            variables (hint(s) inclus). Défaut : 2.
#   acteurs_hint           : optionnel. null si tu ne sais pas — le LLM choisit
#                            parmi les instances d'entités existantes pour
#                            chaque scénario. Sinon un slug d'instance (chaîne)
#                            ou plusieurs (liste) que tu IMPOSES. Un slug
#                            suffixé _<scénario> ne vaut que pour ce scénario.
#   acteurs_hint_count     : optionnel, entier 1-4. Plafond du nombre total
#                            d'acteurs (hint(s) inclus). Défaut : 2.
#   zone_hint              : optionnel. null si tu ne sais pas — le LLM choisit
#                            librement l'ancrage géographique. Sinon une zone
#                            (chaîne libre, ex: "Bassin du Congo") que tu IMPOSES
#                            comme lieu d'ancrage de l'événement — injectée
#                            directement dans le prompt de génération.
#   source                 : libre — date, lien d'article...
#   edition_active          : optionnel, true/false. Défaut false. Si true,
#                            la date/date_label proposée par le LLM est
#                            écrasée par l'édition active (state/editions.json)
#                            -- pour capturer un sujet de l'édition en cours,
#                            où le mois est déjà connu avec certitude
#                            (contrairement à date_approximative, purement
#                            indicative pour le worldbuilding historique).
#                            Avertit sans bloquer si aucune édition active.
#
#   impacts_imposes        : optionnel (simulateur « et si ? »). Forces IMPOSÉES
#                            par scénario, l'IA ne les recalcule pas :
#                              fortress_world:
#                                - {variable: geopolitique_conflits,
#                                   delta_level: 20, duree: 5, polarite: 1}
#                            Mêmes variables dans chaque scénario ; scenarios
#                            null = les scénarios listés ici.
#   date_imposee           : optionnel, année 2025-2098 imposée (prime sur
#                            edition_active).
#   via_matrice_impose     : optionnel, true/false imposé.
#   faits_imposes          : optionnel (simulateur, v8.18). Faits que le récit ne
#                            doit pas contredire, par scénario :
#                              breakdown:
#                                - {fait: "X disparaît en 2076", slug: x_breakdown,
#                                   sort: disparait}
#                            (sort : disparait | change | reste | zone | contrainte ;
#                            « reste » déclenche un ⚠ si le texte détruit l'entité).
# EXEMPLE :
#   - id: guerre_israelo_iranienne
#     description: >
#       Conflit armé direct entre Israël et l'Iran, frappes sur les
#       infrastructures nucléaires et pétrolières, risque d'escalade
#       régionale impliquant les puissances du Golfe.
#     portee: globale
#     date_approximative: 2026
#     intensite: majeure
#     persistance: normale
#     scenarios: null
#     variables_hint: [geopolitique_conflits, energie_ressources_critiques]
#     variables_hint_count: null
#     acteurs_hint: null
#     acteurs_hint_count: null
#     zone_hint: null
#     source: actualite_2026-06
#
# Les idées traitées sont déplacées vers processed.yaml (succès) ou
# needs_review.yaml (échec après corrections automatiques).
# ──────────────────────────────────────────────────────────────────────────────

queue:
  - id: pacte_tabriz_2058
    description: 'En 2058, exsangue après les frappes sur Ispahan–Fordow et coupé des
      marchés du Golfe, l''Iran rompt avec la Zone Golfe Persique–Levant et se place
      sous la protection de l''Arc Eurasien Central, qui l''absorbe : corridors terrestres
      vers la Caspienne, bases eurasiennes sur la côte iranienne d''Ormuz.'
    portee: regionale
    date_approximative: 2058
    intensite: forte
    persistance: durable
    scenarios:
    - breakdown
    variables_hint:
    - geopolitique_conflits
    - energie_ressources_critiques
    - organisation_territoires
    variables_hint_count: 3
    source: et_si_pacte_tabriz_2058
    acteurs_hint:
    - corridors_eurasiens_convoyage_breakdown
    - factions_energetiques_heritieres_des_pactes_abs_breakdown
    - consortium_energetique_oural_caspien_breakdown
    - milices_extractivistes_du_bassin_du_congo_breakdown
    acteurs_hint_count: 4
    faits_imposes:
      breakdown:
      - fait: À partir de 2058, l'Iran fait partie de l'Arc Eurasien Central ; il n'appartient
          plus à la Zone Golfe Persique–Levant.
        sort: contrainte
      - fait: L'Arc Eurasien Central dispose de bases sur la côte iranienne du détroit
          d'Ormuz.
        sort: contrainte
      - fait: 'Les Venelles — Corridors Eurasiens Convoyage (corridors_eurasiens_convoyage_breakdown)
          passe de « déclinant » à « ascendant » après 2058 : elle existe toujours (elle
          peut perdre des lieux, des biens ou du pouvoir), ne la décris pas comme disparue.'
        slug: corridors_eurasiens_convoyage_breakdown
        sort: change
      - fait: 'Factions Énergétiques Héritières des Pactes ABS (factions_energetiques_heritieres_des_pactes_abs_breakdown)
          passe de « émergent » à « dominant » après 2058 : elle existe toujours (elle
          peut perdre des lieux, des biens ou du pouvoir), ne la décris pas comme disparue.'
        slug: factions_energetiques_heritieres_des_pactes_abs_breakdown
        sort: change
      - fait: 'Consortium Énergétique Oural-Caspien (consortium_energetique_oural_caspien_breakdown)
          passe de « émergent » à « ascendant » après 2058 : elle existe toujours (elle
          peut perdre des lieux, des biens ou du pouvoir), ne la décris pas comme disparue.'
        slug: consortium_energetique_oural_caspien_breakdown
        sort: change
      - fait: 'Milices Extractivistes du Bassin du Congo (milices_extractivistes_du_bassin_du_congo_breakdown)
          passe de « émergent » à « marginal » après 2058 : elle existe toujours (elle
          peut perdre des lieux, des biens ou du pouvoir), ne la décris pas comme disparue.'
        slug: milices_extractivistes_du_bassin_du_congo_breakdown
        sort: change
      - fait: 'La zone Arc Eurasien Central (arc_eurasien_central) passe de « fragmenté
          » à « dominant » : le lieu subsiste.'
        slug: arc_eurasien_central
        sort: zone
      - fait: 'La zone Zone Golfe Persique–Levant (zone_golfe_levant) passe de « fragmenté
          » à « en_declin » : le lieu subsiste.'
        slug: zone_golfe_levant
        sort: zone
      - fait: 'La zone Bassin Caspien (Zone de Conflit Bloc IV–Bloc IX) (bassin_caspien_zone_conflit)
          passe de « fragmenté » à « stable » : le lieu subsiste.'
        slug: bassin_caspien_zone_conflit
        sort: zone
      - fait: 'La zone Détroit d''Ormuz (detroit_ormuz) passe de « fragmenté » à « disparu
          » : le lieu disparaît.'
        slug: detroit_ormuz
        sort: zone
    date_imposee: 2058
    impacts_imposes:
      breakdown:
      - variable: geopolitique_conflits
        delta_level: 10
        duree: 3
        polarite: 1
      - variable: energie_ressources_critiques
        delta_level: 8
        duree: 3
        polarite: 1
      - variable: organisation_territoires
        delta_level: 6
        duree: 4
        polarite: 1
    via_matrice_impose: true
